+/*
+ * CPU clock (condemned2-nx). The game is CPU-bound in handheld (its main thread at ~98 % of a core, the three
+ * cores at ~80 %), and apm's handheld configurations leave the CPU at 1020 MHz. Like sys-clk, the rate is set with
+ * clkrst on PcvModuleId_CpuBus; the profile thread's tick puts it back if the system lowers it (a mode change, waking
+ * from sleep), and the rate the console had is restored at exit. 1785 MHz is the rate of the console's own boost
+ * mode, used by commercial games while loading.
+ */
+namespace {
+std::atomic<u32> g_cpu_objetivo{0};
+std::atomic<u32> g_cpu_original{0};
+std::atomic<int> g_correcciones_cpu{0};
+std::atomic<bool> g_aviso_cpu{false};
+std::atomic<bool> g_cpu_por_sysclk{false};
+constexpr u32 kMargenCpuHz = 20000000;
+
+bool LeerCpu(u32& hz) {
+  hz = 0;
+  if (R_FAILED(clkrstInitialize())) return false;
+  bool ok = false;
+  ClkrstSession ses{};
+  if (R_SUCCEEDED(clkrstOpenSession(&ses, PcvModuleId_CpuBus, 3))) {
+    ok = R_SUCCEEDED(clkrstGetClockRate(&ses, &hz));
+    clkrstCloseSession(&ses);
+  }
+  clkrstExit();
+  return ok;
+}
+
+bool FijarCpu(u32 hz) {
+  if (R_FAILED(clkrstInitialize())) return false;
+  bool ok = false;
+  ClkrstSession ses{};
+  if (R_SUCCEEDED(clkrstOpenSession(&ses, PcvModuleId_CpuBus, 3))) {
+    ok = R_SUCCEEDED(clkrstSetClockRate(&ses, hz));
+    clkrstCloseSession(&ses);
+  }
+  clkrstExit();
+  return ok;
+}
+
+void VigilarCpu() {
+  const u32 objetivo = g_cpu_objetivo.load(std::memory_order_relaxed);
+  if (objetivo == 0) return;
+  u32 actual = 0;
+  if (!LeerCpu(actual) || actual + kMargenCpuHz >= objetivo) return;
+  const bool ok = FijarCpu(objetivo);
+  const int n = g_correcciones_cpu.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (!g_aviso_cpu.exchange(true) || n % 60 == 0) {
+    std::fprintf(stderr, "[apm] la CPU habia bajado a %.1f MHz: se vuelve a %.1f (%s, %d vez/veces)\n",
+                 double(actual) / 1e6, double(objetivo) / 1e6, ok ? "aceptado" : "RECHAZADO", n);
+  }
+}
+}  // namespace
+
+extern "C" void RexSwitchApmPedirCpuMhz(int mhz) {
+  u32 actual = 0;
+  if (!LeerCpu(actual)) {
+    std::fprintf(stderr, "[apm] CPU: clkrst no disponible, el reloj se queda como esta\n");
+    return;
+  }
+  u32 esperado = 0;
+  if (g_cpu_original.compare_exchange_strong(esperado, actual)) {
+    std::atexit([] { RexSwitchApmRestaurarCpu(); });
+  }
+  if (mhz <= 0) {
+    RexSwitchApmRestaurarCpu();
+    return;
+  }
+  // The rates pcv knows for the CPU (Erista and Mariko share these).
+  static constexpr u32 kTablaHz[] = {1020000000, 1224000000, 1428000000, 1581000000, 1785000000};
+  u32 hz = kTablaHz[0];
+  for (u32 t : kTablaHz) {
+    if (t <= u32(mhz) * 1000000u + kMargenCpuHz) hz = t;
+  }
+  /*
+   * sys-clk / Horizon OC first: with it running, a rate set through clkrst lasts until its next tick
+   * (~300 ms) and the two would fight every second. Its override is what its own overlay uses and
+   * nothing in its loop overrides that. Only without it is clkrst used, watched by RexSwitchApmVigilar.
+   */
+  if (rex::ui::switch_sysclk::PedirCpu(hz)) {
+    g_cpu_por_sysclk.store(true, std::memory_order_relaxed);
+    g_cpu_objetivo.store(0, std::memory_order_relaxed);
+    std::fprintf(stderr, "[apm] CPU: %.1f -> %.1f MHz pedidos al sysmodule de relojes\n", double(actual) / 1e6,
+                 double(hz) / 1e6);
+    return;
+  }
+  const bool ok = FijarCpu(hz);
+  g_cpu_objetivo.store(ok ? hz : 0, std::memory_order_relaxed);
+  u32 ahora = 0;
+  LeerCpu(ahora);
+  std::fprintf(stderr, "[apm] CPU: %.1f -> %.1f MHz pedidos (%s), lee %.1f MHz\n", double(actual) / 1e6,
+               double(hz) / 1e6, ok ? "aceptado" : "RECHAZADO", double(ahora) / 1e6);
+}
+
+extern "C" void RexSwitchApmRestaurarCpu(void) {
+  g_cpu_objetivo.store(0, std::memory_order_relaxed);
+  if (g_cpu_por_sysclk.exchange(false)) {
+    rex::ui::switch_sysclk::PedirCpu(0);  // the sysmodule puts its own rate back
+    return;
+  }
+  const u32 original = g_cpu_original.load(std::memory_order_relaxed);
+  if (original) FijarCpu(original);
+}
+
+/*
+ * Handheld GPU above Horizon's own profiles (condemned2-nx): 614.4, 691.2 or 768.0 MHz, the last being the
+ * console's docked rate. Only through a clock sysmodule's override (sys-clk / Horizon OC): apm has no handheld
+ * configuration above 460.8 MHz. Returns 1 if the sysmodule took it, 0 otherwise (then the caller stays on apm).
+ * Released at exit.
+ */
+extern "C" int RexSwitchApmPedirGpuOcMhz(int mhz) {
+  static constexpr u32 kTablaHz[] = {614400000, 691200000, 768000000};
+  u32 hz = 0;
+  for (u32 t : kTablaHz) {
+    if (mhz > 0 && t <= u32(mhz) * 1000000u + kMargenCpuHz) hz = t;
+  }
+  static std::atomic<bool> salida{false};
+  if (!hz) {
+    rex::ui::switch_sysclk::PedirGpu(0);
+    return 0;
+  }
+  if (!rex::ui::switch_sysclk::PedirGpu(hz)) {
+    std::fprintf(stderr, "[apm] GPU a %.1f MHz: no hay sysmodule de relojes que lo acepte; se queda en apm\n",
+                 double(hz) / 1e6);
+    return 0;
+  }
+  if (!salida.exchange(true)) {
+    std::atexit([] { rex::ui::switch_sysclk::PedirGpu(0); });
+  }
+  std::fprintf(stderr, "[apm] GPU a %.1f MHz pedidos al sysmodule de relojes\n", double(hz) / 1e6);
+  return 1;
+}
+
 extern "C" void RexSwitchApmVigilar(void) {
