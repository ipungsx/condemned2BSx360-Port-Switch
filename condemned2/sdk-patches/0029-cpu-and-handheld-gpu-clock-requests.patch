     return;  // nothing changed, or we already know this firmware does not allow it
@@ -350,6 +488,9 @@ extern "C" void RexSwitchApmVigilar(void) {
 #else   // !REX_PLATFORM_SWITCH
 extern "C" void RexSwitchApmPedirGpuMhz(int) {}
