 // ---- Copies (resolve and clear)
 
+bool RenderDk::BaseDeMosaico(uint32_t& base, uint32_t formato_guest, uint32_t bpp, uint32_t pitch, uint32_t alto,
+                             uint32_t& dx, uint32_t& dy) {
+  if (!bpp || pitch < 32 || (pitch & 31)) {
+    return false;
+  }
+  const uint32_t b = base & 0x1FFFFFFF;
+  // A texture of its own at the tile's address blocks this only while it is alive: one resolved in this frame or the
+  // last. An older one is a leftover (another level, the menus, or a build that resolved the tile there) and must not
+  // keep the tile out of its texture for the rest of the session.
+  const auto propia = resueltas_.find(b);
+  const bool propia_viva = propia != resueltas_.end() && propia->second.fotograma_escrita + 1 >= fotograma_;
+  const uint32_t bytes_tile = 32 * 32 * bpp, por_fila = pitch / 32;
+  const uint32_t filas = (alto + 31) / 32;
+  for (const auto& [tb, r] : resueltas_) {
+    if (tb >= b || r.formato_guest != formato_guest || r.imagen.ancho != pitch || r.imagen.alto != alto) {
+      continue;
+    }
+    const uint32_t delta = b - tb;
+    if (delta % bytes_tile || delta / bytes_tile >= por_fila * filas) continue;
+    // With a live texture of its own at b, only a texture resolved in this very frame wins (the tile 0 resolve that
+    // comes right before).
+    if (propia != resueltas_.end() && (propia_viva || r.fotograma_escrita != fotograma_)) continue;
+    const uint32_t indice = delta / bytes_tile;
+    dx += (indice % por_fila) * 32;
+    dy += (indice / por_fila) * 32;
+    base = tb;
+    return true;
+  }
+  return false;
+}
